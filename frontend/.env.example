# ---------------------------------------------------------------------
# Copia este archivo como `.env`.
# En desarrollo normalmente NO hace falta cambiar nada.
# Nunca pongas aquí secretos: todo lo que empieza con VITE_ queda visible
# en el navegador de cualquier usuario.
# ---------------------------------------------------------------------

# Destino del proxy de desarrollo. Debe coincidir con el PORT del backend.
VITE_API_TARGET=http://localhost:4000

# Puerto en el que sirve Vite.
VITE_PORT=5173

# URL absoluta del backend. Se deja VACÍA en desarrollo (el proxy de arriba se
# encarga). Solo se define al compilar para producción cuando el frontend se
# sirve desde un dominio distinto al de la API, por ejemplo:
#   VITE_API_URL=https://api.midominio.com
VITE_API_URL=
