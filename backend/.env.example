# ---------------------------------------------------------------------
# Copia este archivo como `.env` y ajusta los valores.
#
#   Linux / macOS:  cp .env.example .env
#   Windows CMD:    copy .env.example .env
#   PowerShell:     Copy-Item .env.example .env
#
# El archivo `.env` real NUNCA se sube al repositorio (está en .gitignore).
# Aquí no debe haber ningún valor real: solo ejemplos y valores por defecto
# de desarrollo.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --------------------------------------------------------------------- BD
# Opción A (recomendada): cadena de conexión completa.
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/distribuidora

# Opción B: por partes. Solo se usa si DATABASE_URL está vacía o comentada.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=CAMBIA_ESTA_CLAVE
# PGDATABASE=distribuidora

# --------------------------------------------------------------- SEGURIDAD
# Clave de firma de los tokens de sesión. OBLIGATORIA en producción.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERA_UNA_CADENA_ALEATORIA_LARGA
JWT_EXPIRES_IN=8h

# Orígenes del navegador autorizados a llamar a la API, separados por coma.
# En desarrollo con el proxy de Vite basta con el puerto 5173.
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------ NEGOCIO
# Zona horaria operativa. Define qué día es "hoy" para ventas y vencimientos.
# OJO: la función app_today() de la base de datos tiene esta zona fija en
# database/migrations/001_init.sql. Si la cambias aquí, hay que crear una
# migración que actualice también esa función.
APP_TIMEZONE=America/Guatemala

# ---------------------------------------------------------------------- n8n
# Con N8N_DISPATCH_ENABLED=false (o sin URL) los eventos se guardan en la
# tabla integration_events pero no se envían. La aplicación funciona igual.
# Ver docs/INTEGRACION-N8N.md
N8N_WEBHOOK_URL=
N8N_DISPATCH_ENABLED=false

# Secreto compartido con n8n para firmar los envíos (HMAC-SHA256).
# El secreto NUNCA viaja: solo viaja la firma. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser el mismo valor que la variable DISTRIBUIDORA_WEBHOOK_SECRET en n8n.
N8N_WEBHOOK_SECRET=

# Cada cuánto revisa el despachador si hay eventos por enviar (ms).
N8N_DISPATCH_INTERVAL_MS=60000
# Tiempo máximo de espera por respuesta del webhook (ms).
N8N_TIMEOUT_MS=10000

# ---------------------------------------------------------------- COBRANZA
# Barrido que genera installment.upcoming e installment.overdue.
COLLECTIONS_SCAN_ENABLED=true
# Días de anticipación con que se avisa de una cuota por vencer.
COLLECTIONS_UPCOMING_DAYS=3
# Cada cuántos días se vuelve a avisar de una cuota vencida.
# 0 = avisar una sola vez cuando se detecta el atraso.
COLLECTIONS_OVERDUE_REPEAT_DAYS=0
# Cada cuánto corre el barrido (ms). 21600000 = 6 horas.
COLLECTIONS_SCAN_INTERVAL_MS=21600000

# ------------------------------------------------------ USUARIO INICIAL
# Solo lo usa `npm run seed` al crear el primer administrador.
# CAMBIA la contraseña antes de usar el sistema con datos reales.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador

# ------------------------------------------------------------- PRUEBAS
# URL contra la que corre `npm run test:flow`. Si se omite usa
# http://localhost:4000. Útil si levantas la API en otro puerto.
# API_URL=http://localhost:4000
