# ---------------------------------------------------------------------
# Copia este archivo como `.env` y ajusta los valores.
# NUNCA subas el archivo `.env` real al repositorio.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distribuidora
# Alternativa por partes (se usa solo si DATABASE_URL no está definida)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=distribuidora

# Seguridad
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-largo
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Zona horaria operativa del negocio
APP_TIMEZONE=America/Guatemala

# ---------------------------------------------------------------------
# Integración con n8n (fase posterior).
# Si N8N_WEBHOOK_URL está vacío, los eventos se registran en la tabla
# integration_events pero no se envían. La aplicación funciona igual.
# ---------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_DISPATCH_ENABLED=false

# Credenciales del usuario administrador inicial (solo para el seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador
