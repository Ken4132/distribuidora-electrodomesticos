{
  "name": "distribuidora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API del sistema de gestión de la distribuidora de electrodomésticos",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/reset.js",
    "db:setup": "npm run migrate && npm run seed",
    "test:flow": "node src/scripts/smoke-test.js",
    "test:security": "node src/scripts/security-test.js",
    "test:normalize": "node src/scripts/normalize-test.js",
    "test:foundation": "node src/scripts/foundation-test.js",
    "test:credits": "node src/scripts/credit-test.js",
    "test:credit-flow": "node src/scripts/credit-workflow-test.js",
    "test:rate-limit": "node src/scripts/rate-limit-test.js",
    "test:payments-base": "node src/scripts/payments-foundation-test.js",
    "test:payments": "node src/scripts/payments-test.js",
        "test:deposits": "node src/scripts/deposits-test.js",
        "test:receipts": "node src/scripts/receipts-test.js",
        "test:collections": "node src/scripts/collections-test.js",
        "test:concurrency": "node src/scripts/concurrency-test.js",
    "n8n:receiver": "node src/scripts/n8n-receiver.js",
    "test:n8n": "node src/scripts/n8n-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
