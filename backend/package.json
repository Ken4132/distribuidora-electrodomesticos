{
  "name": "distribuidora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API del sistema de gestión de la distribuidora de electrodomésticos",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/reset.js",
    "db:setup": "npm run migrate && npm run seed",
    "test:flow": "node src/scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
